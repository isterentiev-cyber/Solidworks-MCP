# SolidWorks MCP Server Configuration
# Author: Samsaam Ali Baig
# Copy this file to .env and configure your settings

# SolidWorks Installation Path (optional)
SOLIDWORKS_PATH=C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Maximum scripts to keep in history
MAX_HISTORY=20

# Which tool sections the MCP server exposes (see solidworks_mcp/toolsets.py).
# Sections: core, select, sketch, features, analysis. "core" is always on.
# Empty or unset = all 50 tools. Needs an MCP restart to take effect.
SW_MCP_TOOLSETS=

# Where the generated makepy cache lives. Default: <repo>/.gen_py
# SW_MCP_GEN_PY=D:\some\other\place

# How long to wait for the SolidWorks main window to answer before a tool
# refuses instead of blocking the server. 0 disables the probe entirely.
# SW_MCP_BUSY_TIMEOUT_MS=1200
